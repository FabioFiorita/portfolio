---
/*
  Draws pixel art from rows of characters. Each character names a colour in the
  palette; '.' is empty. Runs of one colour on a row become one rectangle.
*/
interface Props {
  rows: readonly string[];
  palette: Readonly<Record<string, string>>;
  class?: string;
  label?: string;
}

const { rows, palette, class: className, label } = Astro.props;
const width = Math.max(...rows.map((row) => row.length));
const runs = rows.flatMap((row, y) => {
  const found: { x: number; y: number; length: number; fill: string }[] = [];
  let x = 0;
  while (x < row.length) {
    const key = row[x]!;
    let end = x + 1;
    while (end < row.length && row[end] === key) end++;
    const fill = palette[key];
    if (key !== '.' && fill) found.push({ x, y, length: end - x, fill });
    x = end;
  }
  return found;
});
---

<svg
  data-pixel
  viewBox={`0 0 ${width} ${rows.length}`}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {runs.map((run) => <rect x={run.x} y={run.y} width={run.length} height="1" fill={run.fill} />)}
</svg>
